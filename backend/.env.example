# Copia este archivo como ".env" y ajusta los valores. El .env NO se sube a git.

# Puerto de la API
PORT=3000

# Conexión a MySQL 8. La base DB_NAME se crea sola si no existe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_marfil

# Secreto para firmar los tokens de sesión. Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto

# Duración de la sesión (formato de jsonwebtoken: 30m, 8h, 7d)
JWT_EXPIRES_IN=8h

# Orígenes de los frontends autorizados (separados por coma)
#   5173 = PWA de clientes (frontend/marfil) · 5174 = panel admin (frontend/admin)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Zona horaria del negocio: define qué es "hoy" para reservaciones y métricas
ZONA_HORARIA=America/Monterrey
