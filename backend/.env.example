# Copia este archivo como ".env" y ajusta los valores. El .env NO se sube a git.

# development | test | production
NODE_ENV=development

# Puerto de la API
PORT=3000

# Conexión a MySQL 8. db:init crea la base y aplica migraciones.
# La API usa solo SELECT/INSERT/UPDATE/DELETE; no ejecuta migraciones al arrancar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_marfil

# Secreto para firmar los tokens de sesión. Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (formato de jsonwebtoken: 30m, 8h, 7d)
JWT_EXPIRES_IN=8h

# Orígenes de los frontends autorizados (separados por coma)
#   5173 = PWA de clientes (frontend/marfil) · 5174 = panel admin (frontend/admin)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Zona horaria del negocio: define qué es "hoy" para reservaciones y métricas
ZONA_HORARIA=America/Monterrey

# Solo IPs/CIDR de proxies propios. Vacío si se expone Node directamente.
TRUST_PROXY=

# Límites por IP en ventanas de 15 minutos (almacén local a un proceso).
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
PUBLIC_WRITE_RATE_LIMIT_MAX=30

# db:reset exige que coincida exactamente con DB_NAME. Nunca en producción.
DB_RESET_CONFIRM=

# Correo transaccional y verificación de cuentas
# En desarrollo usa Mailpit local (SMTP 1025, bandeja web http://localhost:8025).
# En producción configura tu proveedor SMTP (Resend, Brevo, SES, Postmark, etc.).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Café Marfil <no-reply@cafemarfil.mx>
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
MAIL_ENABLED=true
MAIL_CHECK_MX=true

# Cloudinary para fotos de menú, actividades y promociones.
# Si CLOUDINARY_CLOUD_NAME queda vacío, las fotos se guardan localmente en backend/uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cafe-marfil
