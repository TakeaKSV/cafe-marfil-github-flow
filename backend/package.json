{
  "name": "cafe-marfil-backend",
  "private": true,
  "version": "0.1.0",
  "description": "API REST y base de datos de Café Marfil (panel admin + PWA de clientes)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/init.js --seed",
    "db:reset": "node src/db/init.js --reset --seed",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
