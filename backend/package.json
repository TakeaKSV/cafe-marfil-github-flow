{
  "name": "cafe-marfil-backend",
  "private": true,
  "version": "1.2.0",
  "description": "API REST y base de datos de Café Marfil (panel admin + PWA de clientes)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/init.js --seed",
    "db:reset": "node src/db/init.js --reset --seed",
    "test": "node --test",
    "lint": "eslint .",
    "format:check": "prettier --check src test eslint.config.js",
    "format": "prettier --write src test eslint.config.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/api.test.js test/migraciones.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
